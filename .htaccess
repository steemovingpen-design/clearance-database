Options -Indexes
RewriteEngine On

# Redirect to HTTPS (Railway provides HTTPS automatically)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Allow access to assets, uploads, and files directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Default: route to index.php if file not found
RewriteRule ^(.*)$ index.php [QSA,L]
